# LLM configuration
# LLM_PROVIDER: "anthropic" (native Claude) or "openai" (OpenAI / OpenAI-compatible)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
LLM_API_KEY=
# Only needed for OpenAI-compatible endpoints (Groq, Together, OpenRouter, etc.)
LLM_BASE_URL=

# Optional. Raises GitHub API rate limit from 60/hr to 5000/hr.
GITHUB_TOKEN=

# Runtime tuning
LLM_MAX_CONCURRENCY=5
GITHUB_MAX_CONCURRENCY=5
